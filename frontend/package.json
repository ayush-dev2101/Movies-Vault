{
  "name": "frontend",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "start:clear": "expo start --clear",
    "android": "npm run android:install",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "env:check": "node scripts/validate-env.js",
    "doctor": "npx expo-doctor",
    "validate": "npm run typecheck && npm run env:check && npm run doctor",
    "android:debug": "npx expo prebuild --platform android && cd android && ./gradlew assembleDebug",
    "android:release": "npx expo prebuild --platform android && cd android && ./gradlew assembleRelease",
    "android:install": "npx expo run:android",
    "clean": "npx rimraf .expo node_modules/.cache android ios && npx expo start --clear",
    "prebuild:clean": "npx expo prebuild --clean --platform android"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.31",
    "@expo/vector-icons": "^14.0.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "axios": "^1.7.2",
    "expo": "~52.0.7",
    "expo-auth-session": "~6.0.0",
    "expo-constants": "~17.0.3",
    "expo-crypto": "~14.0.1",
    "expo-dev-client": "~5.0.4",
    "expo-font": "~13.0.1",
    "expo-linking": "~7.0.3",
    "expo-secure-store": "~14.0.0",
    "expo-splash-screen": "~0.29.11",
    "expo-status-bar": "~2.0.0",
    "expo-web-browser": "~14.0.1",
    "lucide-react-native": "^0.395.0",
    "react": "18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "^0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "^4.4.0",
    "react-native-svg": "15.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.3.12",
    "rimraf": "^6.1.3",
    "typescript": "^5.3.3"
  },
  "private": true
}
